theorem strict_root_R6 : (C11R6D213.N : ℝ) ^ ((1 : ℝ) / (213 : ℕ)) <
    (N : ℝ) ^ ((1 : ℝ) / (213 : ℕ)) := by
  apply Real.rpow_lt_rpow (by positivity) _ (by positivity)
  exact_mod_cast strictly_larger_R6

